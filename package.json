{
  "name": "eggs-backend",
  "version": "1.0.0",
  "description": "Eggs backend",
  "module": "src/server.ts",
  "repository": "https://github.com/BigWhaleLabs/eggs-backend",
  "author": "BigWhaleLabs <eggs@bwl.gg>",
  "license": "MIT",
  "scripts": {
    "start": "bun apply-migrations-if-needed && bun src/server.ts --smol",
    "build-prod": "bun build src/server.ts --target=bun --outdir ./out --smol --minify",
    "build-ts": "tsc --skipLibCheck --noEmit",
    "lint": "bun --bun eslint src test",
    "test": "bun test",
    "prisma-generate": "bun prisma format && bun prisma generate",
    "apply-migrations": "bun prisma migrate deploy",
    "apply-migrations-if-needed": "bun prisma migrate status || bun apply-migrations"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/jsonwebtoken": "^9.0.9",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "jiti": "^2.4.2",
    "typescript-eslint": "^8.26.0"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "ethers": "^6.9.2",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.0",
    "json-bigint-patch": "^0.0.8",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2",
    "viem": "^2.23.6"
  }
}
