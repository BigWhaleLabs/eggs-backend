generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES")
}

model User {
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  id              String      @id @default(cuid())
  serialId        Int         @unique @default(autoincrement())
  authTokens      AuthToken[]
  username        String      @unique
  ethAddress      String?
  hens            Hen[]
  originalHens    Hen[]       @relation("OriginalOwner")
  neynarUserScore Float       @default(0)
  isVerifiedBot   Boolean     @default(false)
  totalHoldings   Float       @default(0)

  @@index([neynarUserScore])
  @@index([isVerifiedBot])
}

model AuthToken {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(cuid())
  token     String
  userAgent String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([token])
}

model Hen {
  id                  String   @id @default(cuid())
  serialId            Int      @unique @default(autoincrement())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  originalOwner       User?    @relation("OriginalOwner", fields: [originalOwnerId], references: [id])
  originalOwnerId     String?
  level               Int      @default(1)
  name                String
  onchainOwnerAddress String?

  @@index([level])
  @@index([userId, level])
  @@index([userId])
  @@index([originalOwnerId])
}
